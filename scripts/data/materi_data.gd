static func by_id(id: String) -> Dictionary:
	for t in TOPIK:
		if t["id"] == id:
			return t
	return {}


static func index_of(id: String) -> int:
	for i in TOPIK.size():
		if TOPIK[i]["id"] == id:
			return i
	return -1
